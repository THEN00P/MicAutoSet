<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DontTouchMyMic.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <Grid RowDefinitions="32,*">
            <Grid x:Name="TitleBarDragRegion" Grid.Row="0" />

            <Grid Grid.Row="1" Padding="24,0,24,6" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE720;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="22" />
                    <TextBlock
                        Text="Don't touch my mic"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Installed version:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind InstalledVersionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Build machine date:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind BuildDateText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Build branch:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind BuildBranchText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Build commit:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind BuildCommitText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <HyperlinkButton
                        Content="Check for updates"
                        Click="CheckForUpdates_Click"
                        Padding="0"
                        VerticalAlignment="Center" />
                    <Button
                        Padding="18,7"
                        Click="CloseButton_Click"
                        Content="Close" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
