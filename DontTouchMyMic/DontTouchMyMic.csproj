<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DontTouchMyMic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TrayIcon.WhiteOutlined.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <LangVersion>default</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <AppInstallerUri>C:\Program Files\Dont touch my mic\</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersionAssembly)</AssemblyVersion>
    <FileVersion>$(AppVersionAssembly)</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <AppxPackageVersion>$(AppVersionPackage)</AppxPackageVersion>
    <BuildMachineTime Condition="'$(BuildMachineTime)' == ''">$([System.DateTimeOffset]::Now.ToString(&quot;yyyy-MM-dd HH:mm:ss zzz&quot;))</BuildMachineTime>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Pages\MainPage.xaml" />
    <None Remove="Pages\SelectorPage.xaml" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\TrayIcon.ico" />
    <Content Include="Assets\TrayIcon.White.ico" />
    <Content Include="Assets\TrayIcon.Black.ico" />
    <Content Include="Assets\TrayIcon.WhiteOutlined.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <Target Name="ResolveBuildMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BuildMetadataRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</_BuildMetadataRepoRoot>
    </PropertyGroup>

    <Exec Condition="'$(BuildBranch)' == '' or '$(BuildBranch)' == 'unknown'" Command="git -C &quot;$(_BuildMetadataRepoRoot)&quot; rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitBranchOutput" />
    </Exec>
    <PropertyGroup>
      <BuildBranch Condition="('$(BuildBranch)' == '' or '$(BuildBranch)' == 'unknown') and '@(_GitBranchOutput)' != ''">@(_GitBranchOutput->'%(Identity)')</BuildBranch>
      <BuildBranch Condition="'$(BuildBranch)' == 'HEAD'"></BuildBranch>
      <BuildBranch Condition="'$(BuildBranch)' == ''">unknown</BuildBranch>
    </PropertyGroup>

    <Exec Condition="'$(BuildCommit)' == '' or '$(BuildCommit)' == 'unknown'" Command="git -C &quot;$(_BuildMetadataRepoRoot)&quot; rev-parse HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitCommitOutput" />
    </Exec>
    <PropertyGroup>
      <BuildCommit Condition="('$(BuildCommit)' == '' or '$(BuildCommit)' == 'unknown') and '@(_GitCommitOutput)' != ''">@(_GitCommitOutput->'%(Identity)')</BuildCommit>
      <BuildCommit Condition="'$(BuildCommit)' == ''">unknown</BuildCommit>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyMetadata Include="BuildMachineTime" Value="$(BuildMachineTime)" />
      <AssemblyMetadata Include="BuildBranch" Value="$(BuildBranch)" />
      <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
    </ItemGroup>
  </Target>

  <Target
    Name="SyncPackageManifestVersion"
    BeforeTargets="PrepareForBuild"
    Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildProjectDirectory)\Package.appxmanifest')">
    <XmlPeek
      XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
      Query="/ns:Package/ns:Identity/@Version"
      Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="_ManifestIdentityVersion" />
    </XmlPeek>

    <XmlPoke
      Condition="'$(_ManifestIdentityVersion)' != '$(AppVersionPackage)'"
      XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
      Query="/ns:Package/ns:Identity/@Version"
      Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;"
      Value="$(AppVersionPackage)" />
  </Target>


  <!-- 
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\SelectorPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioSwitcher\AudioSwitcher.AudioApi.CoreAudio\AudioSwitcher.AudioApi.CoreAudio.csproj" />
    <ProjectReference Include="..\AudioSwitcher\AudioSwitcher.AudioApi\AudioSwitcher.AudioApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\TrayIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Assets\TrayIcon.White.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Assets\TrayIcon.Black.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Assets\TrayIcon.WhiteOutlined.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="Assets\TrayIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\TrayIcon.White.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\TrayIcon.Black.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\TrayIcon.WhiteOutlined.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>False</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <!-- 
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
    Explorer "Package and Publish" context menu entry to be enabled for this project even if 
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
