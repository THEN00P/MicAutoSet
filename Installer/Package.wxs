<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Dont touch my mic"
    Manufacturer="THEN00P"
    Version="$(var.AppVersion)"
    UpgradeCode="{5A5C74A1-3A2D-4DAA-8400-3D57D44C2713}"
    Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Dont touch my mic is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dont touch my mic" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Dont touch my mic" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Dont touch my mic" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="OnboardingMarkerComponent" />
    </Feature>

    <CustomAction
      Id="LaunchInstalledApplication"
      FileRef="DontTouchMyMicExecutable"
      ExeCommand=""
      Return="asyncNoWait"
      Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom
        Action="LaunchInstalledApplication"
        After="InstallFinalize"
        Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\DontTouchMyMic.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="MainExecutableComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="DontTouchMyMicExecutable" Source="$(var.PublishDir)\DontTouchMyMic.exe" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuDir" Guid="*">
      <Shortcut
        Id="StartMenuShortcut"
        Name="Dont touch my mic"
        Target="[INSTALLFOLDER]DontTouchMyMic.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AppIcon" />
      <RemoveFolder Id="ProgramMenuDirCleanup" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\THEN00P\DontTouchMyMic"
        Name="HasStartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component
      Id="OnboardingMarkerComponent"
      Directory="INSTALLFOLDER"
      Guid="*"
      Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED">
      <RegistryValue
        Root="HKCU"
        Key="Software\THEN00P\DontTouchMyMic"
        Name="ShowOnboarding"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
